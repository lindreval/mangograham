generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Language {
  id             Int      @id @default(autoincrement())
  name           String
  isoCode        String   @unique
  transliteration Boolean  @default(false)
  phrases        Phrase[]
}

model Phrase {
  id             Int          @id @default(autoincrement())
  textOriginal   String
  normalized     String       @db.VarChar(255)
  slug           String       @unique
  partOfSpeech   String?
  pronunciation  String?
  transliteration String?
  region         String?
  languageId     Int
  authorId       String?
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  definitions    Definition[]
  language       Language     @relation(fields: [languageId], references: [id])
  author         User?        @relation("UserPhrases", fields: [authorId], references: [id])
  tags           PhraseTag[]

  @@unique([languageId, normalized], name: "normalized_languageId")
  @@index([textOriginal, languageId])
  @@index([languageId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model Definition {
  id        Int              @id @default(autoincrement())
  body      String
  mediaUrl  String?
  authorId  String
  phraseId  Int
  status    String           @default("pending")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation("UserDefinitions", fields: [authorId], references: [id])
  phrase    Phrase           @relation(fields: [phraseId], references: [id])
  votes     DefinitionVote[]
  examples  Example[]

  @@index([authorId])
  @@index([phraseId])
  @@index([status])
  @@index([createdAt])
}

model Example {
  id           Int           @id @default(autoincrement())
  text         String
  translation  String?
  authorId     String
  definitionId Int
  status       String        @default("pending")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  author       User          @relation("UserExamples", fields: [authorId], references: [id])
  definition   Definition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  votes        ExampleVote[]

  @@index([definitionId])
  @@index([authorId])
  @@index([status])
}

model DefinitionVote {
  userId       String
  definitionId Int
  value        Int
  createdAt    DateTime   @default(now())
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, definitionId])
  @@index([definitionId])
  @@index([userId])
}

model ExampleVote {
  userId    String
  exampleId Int
  value     Int
  createdAt DateTime @default(now())
  example   Example  @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, exampleId])
  @@index([exampleId])
  @@index([userId])
}

model User {
  id                  String           @id @default(cuid())
  name                String?
  username            String?          @unique
  email               String?          @unique
  emailVerified       DateTime?
  image               String?
  bio                 String?
  location            String?
  languagesSpoken     String[]         @default([])
  reputation          Int              @default(0)
  role                String           @default("user")
  createdAt           DateTime         @default(now())
  
  // Achievement system fields
  totalAchievements   Int              @default(0)
  achievementPoints   Int              @default(0)
  lastAchievementAt   DateTime?
  
  // Relations
  accounts            Account[]
  definitions         Definition[]     @relation("UserDefinitions")
  examples            Example[]        @relation("UserExamples")
  phrases             Phrase[]         @relation("UserPhrases")
  tags                Tag[]            @relation("UserTags")
  definitionVotes     DefinitionVote[]
  exampleVotes        ExampleVote[]
  sessions            Session[]
  feedback            Feedback[]
  userAchievements    UserAchievement[]

  @@index([createdAt])
  @@index([reputation])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Feedback {
  id          Int      @id @default(autoincrement())
  type        String
  subject     String
  message     String
  email       String?
  userId      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
}

model Tag {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  color     String?     @default("#3B82F6")
  authorId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  author    User        @relation("UserTags", fields: [authorId], references: [id])
  phrases   PhraseTag[]
}

model PhraseTag {
  phraseId  Int
  tagId     Int
  createdAt DateTime @default(now())
  phrase    Phrase   @relation(fields: [phraseId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([phraseId, tagId])
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   // Emoji or icon identifier
  category    AchievementCategory
  tier        Int      @default(1)  // For progressive achievements (1, 2, 3)
  requirements Json    // Flexible criteria storage
  points      Int      @default(0)  // Bonus reputation points for earning
  isHidden    Boolean  @default(false) // Secret achievements
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  userAchievements UserAchievement[]
  
  @@unique([name, tier])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)    // Current progress toward achievement
  maxProgress   Int      @default(1)    // Required progress to unlock
  isCompleted   Boolean  @default(false)
  notified      Boolean  @default(false) // Has user been notified of unlock

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, isCompleted])
  @@index([userId, notified])
  @@index([userId, unlockedAt])
}

enum AchievementCategory {
  REPUTATION    // Migrated tier badges
  CONTRIBUTION  // Content creation achievements
  SOCIAL        // Community interaction achievements  
  LEARNING      // Discovery and exploration achievements
  MILESTONE     // Time-based and special event achievements
  HIDDEN        // Secret/Easter egg achievements
}
