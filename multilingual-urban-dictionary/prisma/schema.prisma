generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id      Int      @id @default(autoincrement())
  name    String
  isoCode String   @unique
  phrases Phrase[]
}

model Phrase {
  id           Int          @id @default(autoincrement())
  textOriginal String
  normalized   String       @db.VarChar(255)
  partOfSpeech String?
  languageId   Int
  createdAt    DateTime     @default(now())
  definitions  Definition[]
  language     Language     @relation(fields: [languageId], references: [id])

  @@unique([languageId, normalized], name: "normalized_languageId")
  @@index([textOriginal, languageId])
}

model Definition {
  id            Int       @id @default(autoincrement())
  body          String
  pronunciation String?
  mediaUrl      String?
  authorId      String
  author        User      @relation("UserDefinitions", fields: [authorId], references: [id])
  phraseId      Int
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  phrase        Phrase    @relation(fields: [phraseId], references: [id])
  votes DefinitionVote[]
  examples      Example[]
}

model Example {
  id           Int        @id @default(autoincrement())
  text         String
  translation  String?
  authorId     String
  definitionId Int
  createdAt    DateTime   @default(now())
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  votes ExampleVote[]
}

model DefinitionVote {
  userId       String
  definitionId Int
  value        Int
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@id([userId, definitionId])
}

model ExampleVote {
  userId     String
  exampleId  Int
  value      Int
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  example    Example   @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@id([userId, exampleId])
}




model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  definitions   Definition[]  @relation("UserDefinitions")
  definitionVotes DefinitionVote[]
  exampleVotes    ExampleVote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
